<style>.square-grid{--grid-line:rgba(255,255,255,.045);--grid-tint:var(--pink,var(--accent,#fc2651));--grid-trail:.45;isolation:isolate}.light .square-grid,.light.square-grid{--grid-line:rgba(15,23,42,.055);--grid-trail:.3}.square-grid-field{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:-1}.square-grid-field.square-grid-fixed{position:fixed}.square-grid-field:after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 50% 45%,transparent 45%,color-mix(in srgb,var(--bg,#0f172a) 80%,transparent))}.square-grid-lines{position:absolute;inset:-75px;background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);background-size:75px 75px;animation:square-grid-drift 40s linear infinite;will-change:transform}@keyframes square-grid-drift{to{transform:translate3d(-75px,75px,0)}}.square-grid-trail{position:absolute;inset:0;width:100%;height:100%}@media(prefers-reduced-motion:reduce){.square-grid-lines{animation:none}.square-grid-trail{display:none}}@font-face{font-family:gn;src:url(data:font/ttf;base64,) format("truetype");font-display:swap}:root{color-scheme:dark;--accent:#fc2651;--bg:#0f172a;--panel:#1e293b;--text:#f1f5f9;--muted:#94a3b8;--border:#334155;--grid:rgba(255,255,255,.045);font-family:Arial,Helvetica,sans-serif;color:var(--text);background:var(--bg)}*{box-sizing:border-box}body{margin:0;min-height:100dvh}.light{color-scheme:light;--bg:#f1f5f9;--panel:#fff;--text:#0f172a;--muted:#64748b;--border:#cbd5e1;--grid:rgba(15,23,42,.055)}button,input,select{font:inherit}button{cursor:pointer}button,a,input,select{-webkit-tap-highlight-color:transparent}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:4px}button{color:var(--text);background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 16px}button:hover{border-color:var(--accent)}button:disabled{cursor:wait;opacity:.6}[hidden]{display:none!important}.topbar{min-height:76px;background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent),white 18%));display:flex;align-items:center;justify-content:space-between;padding:12px max(24px,calc((100vw - 1192px)/2));color:#fff;gap:24px}.wordmark{font-family:gn,monospace;color:inherit;font-size:25px;line-height:1.9;text-decoration:none;white-space:nowrap}.top-actions{display:flex;gap:20px;align-items:center}.top-actions button{background:#0000001a;color:#fff;border-color:#ffffff40;font-size:24px;line-height:1;padding:10px}#clock{white-space:pre-line;text-align:right;font-size:14px;line-height:1.5;font-variant-numeric:tabular-nums}main{max-width:1240px;margin:auto;padding:42px 24px 80px}.section-heading{display:flex;gap:20px;align-items:center;justify-content:space-between;margin-bottom:24px}h1,h2{margin:0;font-size:28px;font-weight:650;letter-spacing:-.8px}.edition{color:var(--muted);font-size:13px}.apps-section{margin-bottom:54px}.app-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:18px}.app-tile{border:0;padding:0;display:flex;align-items:center;flex-direction:column;gap:12px;background:transparent;font-size:14px}.app-tile .app-icon{display:grid;place-items:center;width:76px;height:76px;background:var(--panel);border-radius:22px;border:1px solid var(--border);color:var(--accent);transition:transform .15s}.app-tile:hover .app-icon{transform:translateY(-4px);border-color:var(--accent)}.app-icon svg{width:36px;height:36px}.game-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:22px 18px}.game-card{padding:0;overflow:hidden;background:var(--panel);border:1px solid var(--border);border-radius:12px;text-align:left;min-width:0}.game-art{width:100%;aspect-ratio:1.25;background:color-mix(in srgb,var(--accent) 12%,var(--panel));position:relative;display:grid;place-items:center;overflow:hidden}.game-art span{font-family:gn,monospace;font-size:32px;color:var(--accent);opacity:.5}.game-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.game-name{display:block;padding:13px 12px;font-size:14px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.game-filter input{width:250px;border:1px solid var(--border);border-radius:10px;padding:11px 14px;color:var(--text);background:var(--panel)}#game-count{font-size:15px;font-weight:400;color:var(--muted);letter-spacing:0;margin-left:8px}.more{display:block;margin:30px auto 0;min-width:190px}.sr-only{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden}.loading{position:fixed;inset:76px 0 0;background:var(--bg);display:grid;place-items:center;padding:24px;text-align:center;z-index:10}.loading p{color:var(--muted);max-width:540px;line-height:1.6;overflow-wrap:anywhere}.loading-actions{display:flex;justify-content:center;gap:12px;margin-top:24px}dialog{width:min(460px,calc(100vw - 32px));border:1px solid var(--border);border-radius:18px;background:var(--bg);color:var(--text);padding:26px;max-height:85dvh}dialog::backdrop{background:#0009}.dialog-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}.dialog-heading button{font-size:22px;padding:4px 10px}dialog label{display:block;margin:18px 0 8px;color:var(--muted)}dialog select{width:100%;padding:10px;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:8px}dialog input[type=color]{width:100%;height:44px;padding:5px;background:var(--panel);border:1px solid var(--border);border-radius:8px}dialog p{font-size:13px;line-height:1.6;color:var(--muted)}details{margin-top:24px;font-size:12px;color:var(--muted)}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:10px}@media(max-width:1050px){.app-grid{grid-template-columns:repeat(5,1fr);row-gap:24px}.game-grid{grid-template-columns:repeat(5,1fr)}}@media(max-width:760px){main{padding-top:28px}.game-grid{grid-template-columns:repeat(3,1fr);gap:14px 12px}.app-grid{gap:20px 10px}.app-tile .app-icon{width:60px;height:60px;border-radius:18px}.app-icon svg{width:29px;height:29px}.topbar{padding:12px 18px}.wordmark{font-size:20px}.top-actions{gap:12px}.section-heading{margin-bottom:18px}.game-filter input{width:180px}}@media(max-width:430px){.app-grid{grid-template-columns:repeat(3,1fr)}.game-grid{grid-template-columns:repeat(2,1fr)}.games-heading{align-items:flex-start;flex-direction:column;gap:15px}.game-filter,.game-filter input{width:100%}.wordmark{font-size:17px}.top-actions{gap:8px}#clock{font-size:11px}main{padding-left:16px;padding-right:16px}}@media(prefers-reduced-motion:reduce){.app-tile .app-icon{transition:none}.app-tile:hover .app-icon{transform:none}}.player{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;background:var(--bg)}.player[hidden]{display:none}.player-bar{display:flex;align-items:center;gap:12px;padding:10px max(16px,calc((100vw - 1192px)/2));background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent),white 18%));color:#fff}.player-bar span{flex:1;min-width:0;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.player-bar button{background:#0000001a;color:#fff;border-color:#ffffff40;padding:8px 14px}.player iframe{flex:1;width:100%;border:0;background:#000}.playing .square-grid-field{display:none}
</style>
<style>.topbar,#home,#cancel,.player-bar{display:none!important}.loading{inset:0}.square-grid-field{display:none!important}</style></head>
<body>
<header class="topbar"><a class="wordmark" href="#">gn-math</a><div class="top-actions"><time id="clock"></time><button id="settings" aria-label="settings">⚙</button></div></header>
<main id="home">
<section class="apps-section" aria-labelledby="apps-title"><div class="section-heading"><h1 id="apps-title">apps</h1><span class="edition">singlefile</span></div><div id="apps" class="app-grid"></div></section>
<section aria-labelledby="games-title"><div class="section-heading games-heading"><h2 id="games-title">games <span id="game-count"></span></h2><label class="game-filter"><span class="sr-only">filter games</span><input id="game-filter" type="search" placeholder="find a game" autocomplete="off"></label></div><div id="games" class="game-grid"></div><p id="empty" hidden>no games match that. try another name.</p><button id="more" class="more">show more games</button></section>
</main>
<div id="loading" class="loading" hidden><div><h2 id="loading-title">opening app</h2><p id="status" role="status" aria-live="polite">connecting...</p><div class="loading-actions"><button id="cancel">back home</button><button id="retry" hidden>try again</button></div></div></div>
<div id="player" class="player" hidden><div class="player-bar"><button id="player-back" type="button">back to games</button><span id="player-title"></span><button id="player-full" type="button">fullscreen</button></div></div>
<dialog id="preferences"><form method="dialog"><div class="dialog-heading"><h2>settings</h2><button aria-label="close settings">×</button></div><label for="appearance">appearance</label><select id="appearance"><option value="dark">dark</option><option value="light">light</option></select><label for="accent">accent color</label><input id="accent" type="color" value="#fc2651"><p id="connection-status">connection is chosen automatically</p><button id="reconnect" type="button">find another connection</button><p id="game-route">checking where games load from...</p><p class="settings-note">apps and games need internet. your settings stay in this browser.</p><details><summary>credits</summary><pre id="notices"></pre></details></form></dialog>
