`,"https://www.reddit.com/?gn-reader=1":`<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>reddit \xB7 public reader</title>
<style>
:root{color-scheme:dark;font:15px/1.55 system-ui,sans-serif;background:#0b1016;color:#e8edf3;--muted:#9daab9;--edge:#263340;--accent:#ff754c}*{box-sizing:border-box}body{margin:0}button,input,a{font:inherit}a{color:inherit}button,a.button{cursor:pointer;border:1px solid var(--edge);border-radius:9px;background:#17212c;color:inherit;padding:9px 14px;text-decoration:none}button:hover,a.button:hover{border-color:#6c8297}button:disabled{cursor:wait;opacity:.5}main{max-width:1060px;margin:0 auto;padding:90px 24px 60px}header{display:flex;align-items:flex-start;justify-content:space-between;gap:22px;margin-bottom:25px}.brand{display:flex;gap:12px;align-items:center}.mark{display:grid;place-items:center;border-radius:50%;width:42px;height:42px;background:var(--accent);color:#22120d;font-size:24px;font-weight:800}h1{font-size:24px;line-height:1.2;margin:0 0 3px}.subtitle,.muted{color:var(--muted);font-size:13px}.site-links{display:flex;gap:15px;flex-wrap:wrap;font-size:13px;padding-top:10px}.notice{border-left:3px solid var(--accent);padding:8px 15px;color:#bac6d2;background:#111b25;margin-bottom:24px;font-size:13px}.controls{display:grid;grid-template-columns:180px 1fr auto;gap:10px;align-items:end}label{display:grid;gap:6px;font-size:12px;color:var(--muted)}input{background:#111a24;border:1px solid var(--edge);border-radius:9px;color:inherit;padding:11px 12px;min-width:0;width:100%;font-size:14px}input:focus{outline:2px solid #ff754c70;outline-offset:2px}.controls button{padding:11px 19px;background:#ff754c;color:#20100a;font-weight:650;border-color:transparent}.quick{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0 23px}.quick button{padding:5px 10px;font-size:12px}.feed-bar{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:24px 0 13px}.feed-bar h2{font-size:18px;margin:0}#status{min-height:25px;margin:10px 0;color:var(--muted);font-size:13px}#status.error{color:#ffae91}#retry{margin-bottom:14px}.posts{display:grid;gap:13px}.post{border:1px solid var(--edge);border-radius:13px;background:#111a24;padding:20px}.post-top{display:flex;gap:18px;align-items:flex-start}.post-text{min-width:0;flex:1}.post h3{font-size:18px;line-height:1.4;font-weight:600;margin:7px 0 10px;overflow-wrap:anywhere}.post-title{background:transparent;border:0;border-radius:0;padding:0;font:inherit;text-align:left;line-height:inherit}.post-title:hover{text-decoration:underline}.post p{font-size:14px;white-space:pre-wrap;overflow-wrap:anywhere;color:#cbd6e1;margin:9px 0}.meta{font-size:12px;color:var(--muted);display:flex;gap:9px;flex-wrap:wrap}.preview{width:110px;height:88px;object-fit:cover;border-radius:8px;background:#1a2733;flex:none}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.actions button,.actions a{padding:5px 9px;font-size:12px}.empty{padding:45px 20px;border:1px dashed var(--edge);border-radius:12px;text-align:center;color:var(--muted)}#more{margin:20px auto;display:block}button[hidden],a[hidden],div[hidden]{display:none!important}.back{margin-bottom:15px}@media(max-width:620px){main{padding:88px 14px 35px}header{display:block}.site-links{margin-top:10px}.controls{grid-template-columns:1fr auto}.controls label:first-child{grid-column:1/-1}.post{padding:16px}.post h3{font-size:16px}.preview{width:74px;height:74px}.feed-bar{align-items:flex-start}.notice{font-size:12px}}
</style>
</head>
<body>
<main>
<header><div class="brand"><div class="mark" aria-hidden="true">r</div><div><h1>reddit</h1><div class="subtitle">public reader \xB7 read-only</div></div></div><nav class="site-links" aria-label="reddit site"><a href="https://www.reddit.com/">open reddit website</a><a href="https://old.reddit.com/login/">sign in on reddit</a></nav></header>
<div class="notice">browse public posts and comment feeds from reddit. voting, posting, account features, and the full website depend on reddit allowing this connection.</div>
<form id="feed-form" class="controls"><label>subreddit<input id="subreddit" name="subreddit" maxlength="24" placeholder="all communities" autocomplete="off"></label><label>search public posts<input id="query" name="query" maxlength="160" type="search" placeholder="a topic, title, or keyword" autocomplete="off"></label><button type="submit">browse</button></form>
<div class="quick" aria-label="quick communities"><button data-community="">home feed</button><button data-community="aww">r/aww</button><button data-community="technology">r/technology</button><button data-community="gaming">r/gaming</button><button data-community="AskReddit">r/askreddit</button></div>
<button id="back" class="back" hidden>back to feed</button>
<div class="feed-bar"><div><h2 id="feed-title">public posts</h2><div id="feed-meta" class="muted"></div></div><button id="refresh">refresh</button></div>
<div id="status" role="status" aria-live="polite"></div><button id="retry" hidden>try again</button>
<div id="posts" class="posts"><div class="empty">choose a community or search for a topic.</div></div>
<button id="more" hidden>more posts</button>
</main>
