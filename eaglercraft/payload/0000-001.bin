t-size:clamp(33px,5vw,55px);letter-spacing:-.055em;margin:10px 0 8px}.hero p{color:#d1d5d1;margin:0}.search{display:flex;gap:9px;margin:20px 0 25px;max-width:710px}.search input{background:#242424;border:1px solid #4a4a4a;color:#fff;border-radius:100px;padding:14px 20px;outline:0;flex:1;min-width:0}.search input:focus{border-color:#fff}.search button,.green{background:#fb2651;color:#fff;font-weight:850;border:0;border-radius:100px;padding:12px 22px}.search button:hover,.green:hover{background:#ff5274}.sectionhead{display:flex;align-items:center;justify-content:space-between;margin:22px 0 13px}.sectionhead h2{font-size:21px;letter-spacing:-.035em;margin:0}.sectionhead span{color:#a8a8a8;font-size:13px}.tracks{display:grid;gap:4px}.track{display:grid;grid-template-columns:24px 48px minmax(0,1fr) 56px 30px;align-items:center;gap:14px;border-radius:5px;padding:8px;color:#a8a8a8}.track:hover{background:#ffffff17}.track.current{color:#fb2651}.track .number{font-size:13px;text-align:center}.track img{width:48px;height:48px;border-radius:4px;object-fit:cover;background:#333}.track .details{min-width:0;border:0;background:none;color:#fff;text-align:left;padding:0}.track.current .details strong{color:#fb2651}.track strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:14px;font-weight:600}.track small{display:block;color:#aaa;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.track .duration{text-align:right;font-size:13px}.heart{border:0;background:none;color:#b3b3b3;font-size:22px}.heart.saved{color:#fb2651}.placeholder{border:1px dashed #505050;border-radius:10px;padding:40px 20px;text-align:center;color:#b4b4b4;line-height:1.6}.message{min-height:20px;color:#b3b3b3;font-size:13px}.message.error{color:#ff9696}.right{padding:22px 17px;overflow:auto}.right h3{font-size:16px;margin:0 0 18px}.cover{width:100%;aspect-ratio:1;object-fit:cover;background:linear-gradient(135deg,#74213c,#303030);border-radius:7px}.now{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:15px}.now strong{display:block;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.now small{display:block;color:#b3b3b3;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.now>div{min-width:0}.videohead{font-size:13px;font-weight:750;margin:30px 0 11px}.video{width:100%;aspect-ratio:16/10;background:#070707;border-radius:7px;overflow:hidden}.video iframe{width:100%;height:100%;border:0}.caption{font-size:12px;color:#9a9a9a;line-height:1.5}.footer{height:94px;background:#181818;display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,1.5fr) minmax(0,1fr);align-items:center;gap:20px;padding:11px 17px}.mini{display:flex;align-items:center;gap:11px;min-width:0}.mini img{width:54px;height:54px;border-radius:4px;object-fit:cover;background:#303030}.mini div{min-width:0}.mini strong,.mini small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mini strong{font-size:13px}.mini small{color:#aaa;font-size:11px;margin-top:3px}.controls{min-width:0}.buttons{display:flex;align-items:center;justify-content:center;gap:19px}.icon{background:none;border:0;color:#b9b9b9;font-size:20px}.icon:hover{color:#fff}.play{width:34px;height:34px;border:0;border-radius:50%;background:#fff;color:#111;font-size:18px;display:grid;place-items:center}.seekline{display:flex;align-items:center;gap:9px;margin-top:7px;color:#aaa;font-size:11px;font-variant-numeric:tabular-nums}.seekline input{width:100%;accent-color:#fb2651}.volume{display:flex;justify-content:flex-end;align-items:center;gap:8px;color:#aaa}.volume input{width:90px;accent-color:#fb2651}.hint{font-size:12px;color:#aaa;margin-top:24px}@media(max-width:1050px){.app{grid-template-columns:190px minmax(0,1fr)}.right{display:none}.sidebar{padding:22px 8px}.main{padding:22px}.library strong,.library small{max-width:100px}}@media(max-width:650px){.app{display:block;height:calc(100vh - 134px);padding:0}.sidebar{height:57px;border-radius:0;flex-direction:row;align-items:center;padding:3px 8px}.logo{font-size:19px;padding:0 8px}.nav{width:auto;padding:9px;gap:5px;font-size:12px}.nav .symbol{font-size:17px;width:auto}.divider,.sidehead,.library{display:none}.main{height:calc(100% - 57px);border-radius:0;padding:20px 16px}.hero{margin:25px 0}.track{grid-template-columns:18px 43px minmax(0,1fr) 27px;gap:8px}.track img{width:43px;height:43px}.track .duration{display:none}.footer{height:134px;grid-template-columns:1fr;padding:7px 16px;gap:0}.mini img{width:35px;height:35px}.mini strong{font-size:12px}.mini small{font-size:10px}.volume{display:none}.buttons{gap:17px}.seekline{margin:0}}

/* Playlist and compact player layout */
.app{grid-template-columns:240px minmax(0,1fr)}.app.show-player{grid-template-columns:240px minmax(0,1fr) 310px}.right{display:none}.app.show-player .right{display:block}.main{background:linear-gradient(#35202a 0,#21191e 235px,#121212 420px)}.hero.simple{margin:22px 0 15px}.hero.simple h1{font-size:clamp(30px,4vw,43px);margin:0}.search{margin:18px 0 25px}.playlist-heading{padding:0 10px;display:flex;align-items:center;justify-content:space-between;color:#b9b9b9;font-size:13px;font-weight:750}.playlist-heading button,.player-panel-head button,.dialog-head button{border:0;background:none;color:#bbb;font-size:20px}.playlist-heading button:hover,.player-panel-head button:hover,.dialog-head button:hover{color:#fff}.playlist-nav{overflow:auto;margin-top:8px}.playlist-nav button{border:0;background:none;color:#b8b8b8;border-radius:5px;padding:10px 12px;width:100%;display:flex;gap:10px;align-items:center;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.playlist-nav button:hover,.playlist-nav button.active{background:#242024;color:#fff}.playlist-actions{display:flex;gap:8px;margin-left:auto}.playlist-actions[hidden]{display:none}.playlist-actions button{border:1px solid #555;background:#282328;border-radius:18px;color:#ddd;padding:5px 10px;font-size:12px}.playlist-actions button:hover{color:#fff;border-color:#fb2651}.sectionhead{gap:12px}.sectionhead>span{margin-left:auto}.track{grid-template-columns:24px 48px minmax(0,1fr) 56px 30px 30px}.addtrack{border:0;background:none;color:#bbb;font-size:20px}.addtrack:hover{color:#fb2651}.player-panel-head{display:flex;justify-content:space-between;align-items:center}.player-panel-head h3{margin:0}.right .now{margin:14px 0}.video{aspect-ratio:auto;height:220px;min-height:200px}.right{padding:18px}.right .caption,.right .cover,.right .videohead{display:none}dialog{border:1px solid #484048;border-radius:14px;background:#242024;color:#fff;min-width:min(370px,90vw);padding:20px;box-shadow:0 28px 70px #0009}dialog::backdrop{background:#000a}.dialog-head{display:flex;justify-content:space-between;align-items:center}.dialog-head h2{font-size:18px;margin:0}.dialog-head button{font-size:18px}#songToAdd{font-size:13px;color:#aaa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#playlistChoices{display:grid;gap:5px;max-height:260px;overflow:auto}#playlistChoices button,.dialog-create{border:0;border-radius:7px;background:#343034;color:#fff;padding:11px;text-align:left;width:100%}#playlistChoices button:hover,.dialog-create:hover{background:#493039}.dialog-create{margin-top:12px;color:#ff7590}
@media(max-width:1050px){.app,.app.show-player{grid-template-columns:190px minmax(0,1fr)}.app.show-player .right{position:fixed;right:12px;bottom:106px;width:300px;z-index:9;display:block;box-shadow:0 15px 50px #0009;border:1px solid #393039}.track{grid-template-columns:18px 43px minmax(0,1fr) 30px 30px}.track .duration{display:none}}
@media(max-width:650px){.app,.app.show-player{display:block}.sidebar{height:92px;flex-wrap:wrap;align-content:center}.divider{display:none}.playlist-heading{font-size:12px;padding:0 8px}.playlist-nav{display:flex;overflow:auto;flex:1;margin:0}.playlist-nav button{width:auto;max-width:150px;padding:6px}.main{height:calc(100% - 92px)}.app.show-player .right{bottom:148px;right:8px;width:min(300px,calc(100vw - 16px))}.track{grid-template-columns:16px 42px minmax(0,1fr) 28px 28px;gap:7px}}

#nowCover{display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;margin:18px 0 14px;background:#252025}#nowCover[hidden]{display:none}

*{scrollbar-width:thin;scrollbar-color:#60505a #171317}::-webkit-scrollbar{width:9px;height:9px}::-webkit-scrollbar-track{background:#171317;border-radius:8px}::-webkit-scrollbar-thumb{background:#60505a;border:2px solid #171317;border-radius:8px}::-webkit-scrollbar-thumb:hover{background:#fb2651}::-webkit-scrollbar-corner{background:#171317}
#play::before{content:'';display:block;width:0;height:0;border-top:7px solid transparent;border-bottom:7px solid transparent;border-left:11px solid #111;margin-left:3px}#play.is-playing::before{width:12px;height:14px;border:0;background:linear-gradient(to right,#111 0 4px,transparent 4px 8px,#111 8px 12px);margin-left:0}

.more-row{display:flex;justify-content:center;padding:24px 0 8px}#showMore[hidden]{display:none}#showMore:disabled{opacity:.55;cursor:wait}

.data-actions{display:flex;gap:8px;margin-top:auto;padding:16px 8px 0}.data-actions button{flex:1;border:1px solid #51434c;border-radius:8px;background:#242024;color:#ddd;padding:9px 8px;font-size:12px;white-space:nowrap}.data-actions button:hover{border-color:#fb2651;color:#fff}@media(max-width:650px){.sidebar{height:124px}.main{height:calc(100% - 124px)}.data-actions{width:100%;padding:3px 6px 0;margin-top:0}.data-actions button{padding:4px 8px}}

.loop-toggle{display:grid;place-items:center;position:relative;width:30px;height:30px;border-radius:6px}.loop-toggle[aria-pressed="true"]{color:#fb2651;background:#fb26511a}.loop-toggle[aria-pressed="true"]::after{content:"";position:absolute;bottom:0;width:4px;height:4px;border-radius:50%;background:#fb2651}
</style>
</head>
<body>
<div class="app" id="app"><aside class="sidebar"><div class="logo"><span class="logo-gn">gn</span><span class="logo-music">-music</span></div>
<button class="nav active" id="homeNav"><span class="symbol">\u2302</span> Home</button>
<button class="nav" id="libraryNav"><span class="symbol">\u2661</span> Liked Songs</button>
<div class="divider"></div><div class="playlist-heading"><span>Playlists</span><button id="createPlaylist" title="Create playlist" aria-label="Create playlist">\uFF0B</button></div><div id="playlistNav" class="playlist-nav"></div>
<div class="data-actions"><button id="importData" type="button">Import data</button><button id="exportData" type="button">Export data</button><input id="importFile" type="file" accept="application/json,.json" hidden></div></aside>
<main class="main"><div class="hero simple"><h1>Search for a song</h1></div>
<form id="search" class="search"><input id="query" placeholder="Song or artist" aria-label="Search music" required><button type="submit">Search</button></form>
<p id="message" class="message" role="status" aria-live="polite"></p>
<div class="sectionhead"><h2 id="heading">Recommended songs</h2><span id="resultCount"></span><div id="playlistActions" class="playlist-actions" hidden><button id="renamePlaylist">Rename</button><button id="deletePlaylist">Delete</button></div></div>
<div id="tracks" class="tracks"><div class="placeholder">Loading recommended songs\u2026</div></div><div class="more-row"><button id="showMore" class="green" hidden>Show more</button></div></main>
<aside class="right" id="playerPanel"><div class="player-panel-head"><h3>Now playing</h3><button id="closePlayer" aria-label="Close player and stop playback">\u2715</button></div><img id="nowCover" alt="" hidden referrerpolicy="no-referrer"><div class="now"><div><strong id="nowTitle">Nothing playing</strong><small id="nowArtist">Search to begin</small></div><button id="nowHeart" class="heart" aria-label="Like current song">\u2661</button></div><div class="video" style="height:auto;min-height:0"><audio id="audioPlayer" controls style="width:100%"></audio></div></aside></div>
<dialog id="playlistDialog"><div class="dialog-head"><h2>Add to playlist</h2><button id="closeDialog" aria-label="Close">\u2715</button></div><p id="songToAdd"></p><div id="playlistChoices"></div><button id="newPlaylistInDialog" class="dialog-create">\uFF0B New playlist</button></dialog>
<footer class="footer"><div class="mini"><img id="miniCover" alt="Music placeholder" src="data:image/svg+xml;base64,"><div><strong id="miniTitle">Nothing playing</strong><small id="miniArtist">Soundroom</small></div></div><div class="controls"><div class="buttons"><button class="icon" id="prev" aria-label="Previous">\u23EE</button><button class="play" id="play" aria-label="Play"></button><button class="icon" id="next" aria-label="Next">\u23ED</button><button class="icon loop-toggle" id="loopSong" aria-label="Loop song" aria-pressed="false" title="Loop song: off"><svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div><div class="seekline"><span id="time">0:00</span><input id="seek" type="range" min="0" max="100" value="0" aria-label="Seek"><span id="length">0:00</span></div></div><div class="volume">\u266A <input id="volume" type="range" min="0" max="100" value="80" aria-label="Volume"></div></footer>
